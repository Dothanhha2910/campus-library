# Copy to backend/.env and edit. All values are optional.
PORT=3000
JWT_SECRET=change-me
# Google single sign-on (see README, "Google sign-in"):
GOOGLE_CLIENT_ID=
# LOCAL TESTING ONLY - lets you simulate Google accounts without a client ID:
GOOGLE_MOCK=1
# Minutes an account stays locked after 5 failed logins:
LOCK_MINUTES=1
# 1 (default) = app contains the planted bugs, 0 = clean reference behaviour
INJECT_BUGS=1
