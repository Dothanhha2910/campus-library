{
  "name": "campus-library-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright functional test suite for Campus Library (Page Object Model)",
  "scripts": {
    "test": "npm run check:pom && playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "check:pom": "node scripts/check-pom.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
